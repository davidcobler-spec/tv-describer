{
  "outputDirectory": "public",
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [
      { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self)" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] }
  ]
}
